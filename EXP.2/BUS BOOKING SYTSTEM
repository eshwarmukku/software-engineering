
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bus Ticket Booking</title>
<style>
* {
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}
body {
  margin: 0;
  background: #f2f5fb;
  color: #202943;
}
header {
  background: #1746a2;
  color: white;
  padding: 22px;
  text-align: center;
}
.container {
  max-width: 600px;
  margin: 25px auto;
  padding: 20px;
}
.card {
  background: white;
  padding: 22px;
  margin-bottom: 18px;
  border-radius: 14px;
  box-shadow: 0 3px 12px #00000012;
}
h2 { margin-top: 0; }
label {
  display: block;
  margin: 12px 0 6px;
  font-weight: bold;
}
input, select {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccd3e0;
  border-radius: 7px;
  background: white;
}
button {
  background: #1746a2;
  color: white;
  border: none;
  border-radius: 7px;
  padding: 12px;
  cursor: pointer;
  font-weight: bold;
}
button:hover { background: #0d327d; }
.primary { width: 100%; margin-top: 16px; }
.bus {
  border: 1px solid #dbe2ef;
  border-radius: 10px;
  padding: 15px;
  margin-top: 12px;
}
.bus button { margin-top: 10px; }
.seats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin: 20px 0;
}
.seat {
  background: #e2f5e9;
  color: #17683a;
  border: 1px solid #77c997;
}
.seat.selected {
  background: #1746a2;
  color: white;
}
.seat:disabled {
  background: #d5d9e1;
  color: #666;
  cursor: not-allowed;
}
.hidden { display: none; }
.note { color: #626d82; font-size: 14px; }
.success { color: #168044; font-weight: bold; }
</style>
</head>
<body>

<header>
  <h1>🚌 EasyBus</h1>
  <p>Book your journey with ease</p>
</header>

<div class="container">

  <section class="card" id="searchScreen">
    <h2>Search Buses</h2>

    <label>From</label>
    <select id="from">
      <option>Chennai</option>
      <option>Bengaluru</option>
      <option>Hyderabad</option>
      <option>Coimbatore</option>
    </select>

    <label>To</label>
    <select id="to">
      <option>Bengaluru</option>
      <option>Chennai</option>
      <option>Hyderabad</option>
      <option>Coimbatore</option>
    </select>

    <label>Journey Date</label>
    <input type="date" id="date">

    <label>Passengers</label>
    <select id="passengers">
      <option value="1">1 Passenger</option>
      <option value="2">2 Passengers</option>
      <option value="3">3 Passengers</option>
      <option value="4">4 Passengers</option>
    </select>

    <button class="primary" onclick="searchBuses()">
      Search Buses
    </button>
    <p class="note" id="searchMessage"></p>
  </section>

  <section class="card hidden" id="busScreen">
    <h2>Available Buses</h2>
    <p id="route"></p>

    <div class="bus">
      <h3>Express Travels</h3>
      <p>AC Sleeper · 08:00 AM – 02:00 PM</p>
      <p>Fare: ₹650 per seat</p>
      <button onclick="chooseBus('Express Travels',650)">
        Select Bus
      </button>
    </div>

    <div class="bus">
      <h3>CityLine Travels</h3>
      <p>Non-AC Seater · 09:30 AM – 04:00 PM</p>
      <p>Fare: ₹450 per seat</p>
      <button onclick="chooseBus('CityLine Travels',450)">
        Select Bus
      </button>
    </div>
  </section>

  <section class="card hidden" id="seatScreen">
    <h2>Select Your Seats</h2>
    <p class="note">Green = Available | Blue = Selected | Grey = Booked</p>

    <div class="seats" id="seatGrid"></div>

    <p id="seatInfo">Selected seats: None</p>
    <p id="total">Total: ₹0</p>

    <label>Passenger Name</label>
    <input id="name" type="text" placeholder="Enter your name">

    <label>Mobile Number</label>
    <input id="phone" type="tel" maxlength="10"
           placeholder="10-digit mobile number">

    <button class="primary" onclick="confirmBooking()">
      Confirm Booking
    </button>
  </section>

  <section class="card hidden" id="confirmation">
    <h2 class="success">✓ Booking Confirmed!</h2>
    <p id="ticketDetails"></p>
    <p class="note">
      Prototype only: no real ticket or payment is generated.
    </p>
    <button class="primary" onclick="location.reload()">
      Book Another Ticket
    </button>
  </section>

</div>

<script>
let busName = "";
let fare = 0;
let selectedSeats = [];
let passengerCount = 1;

document.getElementById("date").min =
  new Date().toISOString().split("T")[0];

function searchBuses() {
  const from = document.getElementById("from").value;
  const to = document.getElementById("to").value;
  const date = document.getElementById("date").value;

  if (from === to) {
    alert("Please select different starting and destination cities.");
    return;
  }

  if (!date) {
    alert("Please select your journey date.");
    return;
  }

  if (date < new Date().toISOString().split("T")[0]) {
    alert("Please select today or a future date.");
    return;
  }

  document.getElementById("route").textContent =
    from + " → " + to + " | " + date;

  document.getElementById("busScreen").classList.remove("hidden");
  document.getElementById("busScreen").scrollIntoView({
    behavior: "smooth"
  });
}

function chooseBus(name, price) {
  busName = name;
  fare = price;
  passengerCount = Number(
    document.getElementById("passengers").value
  );
  selectedSeats = [];

  const grid = document.getElementById("seatGrid");
  grid.innerHTML = "";

  for (let i = 1; i <= 12; i++) {
    const seat = document.createElement("button");
    seat.textContent = "S" + i;
    seat.className = "seat";

    // Example of already-booked seats
    if ([3, 8].includes(i)) {
      seat.disabled = true;
      seat.title = "Already booked";
    } else {
      seat.onclick = () => toggleSeat(i, seat);
    }

    grid.appendChild(seat);
  }

  document.getElementById("seatScreen").classList.remove("hidden");
  document.getElementById("seatScreen").scrollIntoView({
    behavior: "smooth"
  });
  updateSeats();
}

function toggleSeat(number, button) {
  if (selectedSeats.includes(number)) {
    selectedSeats = selectedSeats.filter(s => s !== number);
    button.classList.remove("selected");
  } else {
    if (selectedSeats.length >= passengerCount) {
      alert("You can select up to " + passengerCount + " seat(s).");
      return;
    }
    selectedSeats.push(number);
    button.classList.add("selected");
  }

  updateSeats();
}

function updateSeats() {
  document.getElementById("seatInfo").textContent =
    "Selected seats: " +
    (selectedSeats.length ? selectedSeats.join(", ") : "None");

  document.getElementById("total").textContent =
    "Total: ₹" + (selectedSeats.length * fare);
}

function confirmBooking() {
  const name = document.getElementById("name").value.trim();
  const phone = document.getElementById("phone").value.trim();
  const date = document.getElementById("date").value;

  if (!name) {
    alert("Please enter your name.");
    return;
  }

  if (!/^[6-9]\d{9}$/.test(phone)) {
    alert("Enter a valid 10-digit Indian mobile number.");
    return;
  }

  if (selectedSeats.length !== passengerCount) {
    alert("Please select exactly " + passengerCount + " seat(s).");
    return;
  }

  document.getElementById("ticketDetails").innerHTML =
    "<b>Passenger:</b> " + escapeHTML(name) + "<br><br>" +
    "<b>Route:</b> " + escapeHTML(document.getElementById("from").value) +
    " → " + escapeHTML(document.getElementById("to").value) + "<br><br>" +
    "<b>Date:</b> " + date + "<br><br>" +
    "<b>Bus:</b> " + escapeHTML(busName) + "<br><br>" +
    "<b>Seats:</b> " + selectedSeats.join(", ") + "<br><br>" +
    "<b>Total Fare:</b> ₹" + (selectedSeats.length * fare);

  document.getElementById("confirmation").classList.remove("hidden");
  document.getElementById("confirmation").scrollIntoView({
    behavior: "smooth"
  });
}

function escapeHTML(value) {
  return value.replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}
</script>

</body>
</html>
